<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>rockerswitch.ac</path>

  <animation>
  
 
   
    <object-name>fuel-pump</object-name>
  
   
  </animation>

  <animation>
    <type>material</type>
   
    <object-name>fuel-pump</object-name>
  
   
   <condition>
	<or>
	<equals>
      <property>controls/electric/engine/generator</property>
	  <value>true</value>
	  </equals>
	  <equals>
      <property>controls/electric/engine[1]/generator</property>
	  <value>true</value>
	  </equals>
	  <equals>
      <property>/controls/electric/battery-switch</property>
	  <value>true</value>
	  </equals>
	  </or>
    </condition>
    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
      <red>   0.50 </red>
      <green> 0.25 </green>
      <blue>  0.25 </blue>
    </emission>
  </animation>

  <!-- battery -->
  <animation>
    <type>pick</type>
    <object-name>fuel-pump</object-name>
    <action>
      <button>0</button>
      <binding>
        <command>property-toggle</command>
        <property>controls/electric/battery-switch</property>
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>/sim/sound/switch</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>fuel-pump</object-name>
    <property>controls/electric/battery-switch</property>
    <factor>  35 </factor>
    <min-deg>  0 </min-deg>
    <max-deg> 35 </max-deg>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

 


   
                                
 
</PropertyList>

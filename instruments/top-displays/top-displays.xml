  <type type="string">literal</type>
  <text type="string">CAUTION</text>
  <draw-text type="bool">true</draw-text>
  <alignment>left-top</alignment>
 </text>
 
 <animation>
    <type>select</type>
    <object-name>caution</object-name>
	
  <condition>
  <or>
      <less-than>
				<property>rotors/main/rpm</property>
						<value>320</value>
					</less-than>
				<greater-than>
				<property>rotors/main/rpm</property>
						<value>370</value>
					</greater-than>
	  <equals>
				<property>controls/electric/engine[1]/generator</property>
						<value>false</value>
					</equals>
							
			 <equals>
      <property>controls/electric/engine/generator</property>
						<value>false</value>
	   </equals>
	   
	    <greater-than>
          <property>sim/failure-manager/systems/pitot/failure-level</property>
          <value>0.3</value>
        </greater-than>
		
		<and>
          <less-than>
            <property>environment/temperature-degc</property>
            <value>4.0</value>
          </less-than>

          <not>
            <property>controls/anti-ice/pitot-heat</property>
			<value>true</value>
          </not>
		  </and>
      <equals>
                 <property>sim/model/bo105/doors/door[0]/position-norm</property>
	            <value>1</value>
	            </equals>
		
		         <equals>
                 <property>sim/model/bo105/doors/door[1]/position-norm</property>
	            <value>1</value>
	            </equals>
				
				 <equals>
                 <property>sim/model/bo105/doors/door[2]/position-norm</property>
	            <value>1</value>
	            </equals>
				
				 <equals>
                 <property>sim/model/bo105/doors/door[3]/position-norm</property>
	            <value>1</value>
	            </equals>
	  
	  </or>
	  </condition>
	</animation>
	
	<animation> 
		<type>material</type>
		<object-name>master-caution</object-name>
		<emission> 
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
		</emission>
	</animation>
	
	<animation> 
		<type>select</type>
		<object-name>fuel-low</object-name>
		<condition>
			<less-than>
			<property>consumables/fuel/total-fuel-gals</property>
			<value>80</value>
			</less-than>
		</condition>
	</animation>
	
	<animation> 
		<type>material</type>
		<object-name>fuel-low</object-name>
		<emission> 
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
		</emission>
	</animation>
	
	<animation> 
		<type>select</type>
		<object-name>rtr-rpm</object-name>
		<condition>
		<or>
			<less-than>
			<property>rotors/main/rpm</property>
			<value>320</value>
			</less-than>
			<greater-than>
			<property>rotors/main/rpm</property>
			<value>370</value>
			</greater-than>
			</or>
		</condition>
	</animation>
	
	<animation> 
		<type>material</type>
		<object-name>rtr-rpm</object-name>
		<emission> 
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
		</emission>
	</animation>
	
	<animation> 
		<type>select</type>
		<object-name>trq</object-name>
		<condition>
			<less-than>
			<property>rotors/gear/total-torque</property>
			<value>22000</value>
			</less-than>
		</condition>
	</animation>
	
	<animation> 
		<type>material</type>
		<object-name>trq</object-name>
		<emission> 
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
		</emission>
	</animation>

</PropertyList>
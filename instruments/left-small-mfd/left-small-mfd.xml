<!-- Fuel Level LBS-->

	<animation>
		<type>textranslate</type>
		<object-name>fuel.001</object-name>
		<property>consumables/fuel/total-fuel-gals</property>
		<factor>0.10</factor>
		<step>1</step>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	
	<animation>
		<type>textranslate</type>
		<object-name>fuel.002</object-name>
		<property>consumables/fuel/total-fuel-gals</property>
		<factor>0.010</factor>
		<step>10</step>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>fuel.002</object-name>
		<condition>
			<greater-than-equals>
				<property>consumables/fuel/total-fuel-gals</property>
				<value>10</value>
			</greater-than-equals>
		</condition>
	</animation>
	
	<animation>
		<type>textranslate</type>
		<object-name>fuel.003</object-name>

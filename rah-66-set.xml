	            <float n="7" alias="/position/gear-agl-m"/>	<!-- rotor particles -->
	            <float n="8" alias="/orientation/roll-deg"/><!-- rotor particles -->
	            <float n="9" alias="/rotors/main/torque"/>	<!-- rotor particles -->
				<float n="10" alias="/baydoors/position-norm"/>	<!-- weapon bay doors -->
				
				<float n="4" alias="/sim/model/turret-positions/turretz"/>
				<float n="5" alias="/sim/model/turret-positions/turretx"/>

				<!-- Payload over multiplayer -->
				<string alias="/sim/weight[2]/selected" n="2"/> 
				<string alias="/sim/weight[3]/selected" n="3"/> 
				<string alias="/sim/weight[4]/selected" n="4"/> 
				<string alias="/sim/weight[5]/selected" n="5"/> 
				<string alias="/sim/weight[6]/selected" n="6"/> 
				<string alias="/sim/weight[7]/selected" n="7"/>
				
			</generic>
		</multiplay>
		
